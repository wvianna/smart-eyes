        "name": "get global val format csv",
        "func": "var msg1 = {};\nvar msg2 = {};\nvar msg3 = {};\nvar nivel=global.get('nivel') || 0;\nvar sensor2=global.get('sensor2') || 0;\nvar sensor3=global.get('sensor3') || 0;\n\nmsg1.payload = nivel;\nmsg2.payload = sensor2;\nmsg3.payload = sensor3;\n\nmsg.payload = msg.datahora + \";\" + msg1.payload + \";\" + msg2.payload + \";\" + msg3.payload;\nreturn msg;\n//node.send([[msg1,msg2,msg3]]);",
